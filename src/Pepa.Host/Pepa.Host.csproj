<Project Sdk="Microsoft.NET.Sdk">
  <!-- Композиция приложения: хранилище + движок + адаптеры + локальный HTTP API + раздача интерфейса.
       Используется и оконным приложением (Pepa.Desktop), и сервером без окна (Pepa.Server). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pepa.Engine\Pepa.Engine.csproj" />
    <ProjectReference Include="..\Pepa.Storage.Sqlite\Pepa.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\Pepa.Adapters.FileSystem\Pepa.Adapters.FileSystem.csproj" />
    <ProjectReference Include="..\Pepa.Adapters.Browser\Pepa.Adapters.Browser.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Собранный интерфейс (ui/ → npm run build) копируется рядом с приложением. -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pepa.Host.Tests" />
  </ItemGroup>
</Project>
