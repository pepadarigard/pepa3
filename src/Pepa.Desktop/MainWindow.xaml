<Window x:Class="Pepa.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pepa"
        Icon="Assets/pepa.ico"
        Width="1360" Height="880"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" Visibility="Hidden" />

        <!-- Пока интерфейс загружается или если WebView2 недоступен. -->
        <Border x:Name="Placeholder">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock x:Name="PlaceholderTitle" Text="Pepa запускается…" FontSize="20" FontWeight="SemiBold"
                           TextAlignment="Center" Margin="0,0,0,12" />
                <TextBlock x:Name="PlaceholderText" Text="" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                           Opacity="0.8" />
                <StackPanel x:Name="PlaceholderActions" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,18,0,0" Visibility="Collapsed">
                    <Button x:Name="InstallButton" Content="Установить WebView2 Runtime" Padding="14,6" Margin="0,0,8,0"
                            Click="OnInstallWebView" />
                    <Button x:Name="BrowserButton" Content="Открыть в браузере" Padding="14,6" Click="OnOpenInBrowser" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
